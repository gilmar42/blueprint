{
  "name": "video-commerce-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "postbuild": "mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && if [ -d public ]; then cp -r public .next/standalone/public; fi",
    "typecheck": "tsc --noEmit",
    "xampp:create-db": "node --env-file=.env backend/src/create-database.js",
    "xampp:migrate": "node --env-file=.env backend/src/migrate.js",
    "xampp:api": "node --env-file=.env backend/src/api.js",
    "xampp:worker": "node --env-file=.env backend/src/worker.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
